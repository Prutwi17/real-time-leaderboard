# Copy to .env and fill with REAL values locally. NEVER commit .env.
# All values below are placeholders only.

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=leaderboard
MYSQL_USERNAME=your_username
MYSQL_PASSWORD=your_password

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- JWT (generate a real secret: openssl rand -base64 48) ----
JWT_SECRET=replace_with_secure_random_secret
JWT_EXPIRATION=86400000

# ---- Service discovery / gateway ----
EUREKA_SERVER_URL=http://localhost:8761/eureka
API_GATEWAY_URL=http://localhost:8080

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080
