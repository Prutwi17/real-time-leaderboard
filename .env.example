# Copy to .env and fill with REAL values locally. NEVER commit .env.
# All values below are placeholders only.

# ---- MySQL (each microservice owns its own schema; set MYSQL_DATABASE per service) ----
# auth-service: leaderboard_auth · sport-service: leaderboard_sport · score-service: leaderboard_score · user-service: leaderboard_user
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=leaderboard_auth
MYSQL_USERNAME=your_username
MYSQL_PASSWORD=your_password

# ---- Redis (used from the leaderboard phase onward) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Kafka (used from the event-driven phase onward) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SCORE_SUBMITTED=leaderboard.score.submitted
KAFKA_DLT_TOPIC_SCORE_SUBMITTED=leaderboard.score.submitted.DLT

# ---- JWT (generate a real secret: openssl rand -base64 48; must be >= 32 bytes) ----
JWT_SECRET=replace_with_secure_random_secret
JWT_ACCESS_TOKEN_EXPIRATION=900000      # ms, default 15 minutes
JWT_REFRESH_TOKEN_EXPIRATION=604800000  # ms, default 7 days

# ---- Internal service-to-service secret (score→leaderboard) ----
INTERNAL_SERVICE_SECRET=replace_with_secure_random_secret

# ---- Service discovery / gateway ----
EUREKA_SERVER_URL=http://localhost:8761/eureka
API_GATEWAY_URL=http://localhost:8080

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080
